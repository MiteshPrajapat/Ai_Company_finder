# Job Finder AI - Environment Configuration
APP_ENV=development
APP_NAME="Job Finder AI"
DATABASE_PATH=data/job_finder.db
LOG_LEVEL=INFO

# Browser settings
BROWSER_TYPE=chrome
BROWSER_HEADLESS=false
REQUEST_TIMEOUT=30
PAGE_TIMEOUT=30

# Matching settings
RELEVANCE_THRESHOLD=50
MAX_CONCURRENT_WORKERS=3
DELAY_BETWEEN_REQUESTS=1.5
SEARCH_ENGINE_FALLBACK=auto

# AI & OpenRouter Settings (Optional - Can also be configured in App Settings UI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Candidate Profile Settings (Optional)
USER_FULL_NAME=
USER_EMAIL=
USER_PHONE=
USER_LINKEDIN=
USER_PORTFOLIO=
